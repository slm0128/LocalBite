<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://example.org/bpmn/abo-aenderung" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:message id="Message_BestaetigungsEmail" name="Bestätigungs-E-Mail" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Kunde" name="Kunde" processRef="Process_Kunde" />
    <bpmn:participant id="Participant_Unternehmen" name="Unternehmen" processRef="Process_Unternehmen" />
    <bpmn:messageFlow id="MF_1" name="Login-Anfrage" sourceRef="Task_Login" targetRef="Task_OptionenAnzeigen" />
    <bpmn:messageFlow id="MF_2" name="Änderungswunsch" sourceRef="Task_OptionWaehlen" targetRef="Task_EingabenEntgegennehmen" />
    <bpmn:messageFlow id="MF_3" name="Prüfergebnis" sourceRef="Task_PruefergebnisAnzeigen" targetRef="Task_ZusammenfassungPruefen" />
    <bpmn:messageFlow id="MF_4" name="Bestätigung" sourceRef="Task_BestaetigungSenden" targetRef="Task_AuftragAnBackend" />
    <bpmn:messageFlow id="MF_5" name="Bestätigungs-E-Mail" sourceRef="Task_EmailGenerieren" targetRef="ICE_EmailEmpfangen" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Kunde" isExecutable="false">
    <bpmn:startEvent id="SE_Kunde" name="Wunsch nach Abo-Änderung/Pause">
      <bpmn:outgoing>SF_K1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Login" name="Login im Kundenportal durchführen">
      <bpmn:incoming>SF_K1</bpmn:incoming>
      <bpmn:outgoing>SF_K2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OptionWaehlen" name="Änderungsoption und Parameter wählen">
      <bpmn:incoming>SF_K2</bpmn:incoming>
      <bpmn:outgoing>SF_K3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ZusammenfassungPruefen" name="Zusammenfassung und Kosten prüfen">
      <bpmn:incoming>SF_K3</bpmn:incoming>
      <bpmn:outgoing>SF_K4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BestaetigungSenden" name="Bestätigung senden">
      <bpmn:incoming>SF_K5</bpmn:incoming>
      <bpmn:outgoing>SF_K7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Bestaetigen" name="Änderung verbindlich bestätigen?" gatewayDirection="Diverging">
      <bpmn:incoming>SF_K4</bpmn:incoming>
      <bpmn:outgoing>SF_K5</bpmn:outgoing>
      <bpmn:outgoing>SF_K6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="ICE_EmailEmpfangen" name="Bestätigungs-E-Mail empfangen">
      <bpmn:incoming>SF_K7</bpmn:incoming>
      <bpmn:outgoing>SF_K8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgEvtDef_1" messageRef="Message_BestaetigungsEmail" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EE_Erfolg" name="Abo erfolgreich geändert/pausiert">
      <bpmn:incoming>SF_K8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EE_Abbruch" name="Vorgang abgebrochen">
      <bpmn:incoming>SF_K6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_K1" sourceRef="SE_Kunde" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="SF_K2" sourceRef="Task_Login" targetRef="Task_OptionWaehlen" />
    <bpmn:sequenceFlow id="SF_K3" sourceRef="Task_OptionWaehlen" targetRef="Task_ZusammenfassungPruefen" />
    <bpmn:sequenceFlow id="SF_K4" sourceRef="Task_ZusammenfassungPruefen" targetRef="GW_Bestaetigen" />
    <bpmn:sequenceFlow id="SF_K5" name="Ja" sourceRef="GW_Bestaetigen" targetRef="Task_BestaetigungSenden" />
    <bpmn:sequenceFlow id="SF_K6" name="Nein" sourceRef="GW_Bestaetigen" targetRef="EE_Abbruch" />
    <bpmn:sequenceFlow id="SF_K7" sourceRef="Task_BestaetigungSenden" targetRef="ICE_EmailEmpfangen" />
    <bpmn:sequenceFlow id="SF_K8" sourceRef="ICE_EmailEmpfangen" targetRef="EE_Erfolg" />
  </bpmn:process>
  <bpmn:process id="Process_Unternehmen" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Frontend" name="Kundenportal (Frontend)">
        <bpmn:flowNodeRef>SE_Unternehmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OptionenAnzeigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EingabenEntgegennehmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnfrageAnBackend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PruefergebnisAnzeigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuftragAnBackend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ErfolgsmeldungAnzeigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Unternehmen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend" name="Abo-Verwaltungssystem (Backend)">
        <bpmn:flowNodeRef>Task_ZulaessigkeitPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Zulaessig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KonditionenBerechnen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FehlermeldungGenerieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_BackendAbbruch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_AenderungsArt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TarifAktivieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AboPausieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Zusammenfuehrung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZahlungsGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmailGenerieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_EndSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Backend</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SE_Unternehmen">
      <bpmn:outgoing>SF_U01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_OptionenAnzeigen" name="Änderungsoptionen anzeigen">
      <bpmn:incoming>SF_U01</bpmn:incoming>
      <bpmn:outgoing>SF_U02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EingabenEntgegennehmen" name="Eingaben des Kunden entgegennehmen">
      <bpmn:incoming>SF_U02</bpmn:incoming>
      <bpmn:outgoing>SF_U03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AnfrageAnBackend" name="Anfrage zur Prüfung an Backend senden">
      <bpmn:incoming>SF_U03</bpmn:incoming>
      <bpmn:outgoing>SF_U04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PruefergebnisAnzeigen" name="Prüfergebnis anzeigen">
      <bpmn:incoming>SF_U09</bpmn:incoming>
      <bpmn:outgoing>SF_U10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AuftragAnBackend" name="Änderungsauftrag an Backend übermitteln">
      <bpmn:incoming>SF_U10</bpmn:incoming>
      <bpmn:outgoing>SF_U11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ErfolgsmeldungAnzeigen" name="Erfolgsmeldung anzeigen">
      <bpmn:incoming>SF_U20</bpmn:incoming>
      <bpmn:outgoing>SF_U21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EE_Unternehmen" name="Verarbeitung abgeschlossen">
      <bpmn:incoming>SF_U21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ZulaessigkeitPruefen" name="Zulässigkeit der Änderung/Pause prüfen">
      <bpmn:incoming>SF_U04</bpmn:incoming>
      <bpmn:outgoing>SF_U05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KonditionenBerechnen" name="Neue Konditionen berechnen">
      <bpmn:incoming>SF_U08</bpmn:incoming>
      <bpmn:outgoing>SF_U09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FehlermeldungGenerieren" name="Fehlermeldung generieren">
      <bpmn:incoming>SF_U06</bpmn:incoming>
      <bpmn:outgoing>SF_U07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TarifAktivieren" name="Neuen Tarif in Datenbank aktivieren">
      <bpmn:incoming>SF_U12</bpmn:incoming>
      <bpmn:outgoing>SF_U14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AboPausieren" name="Abo-Status auf &#39;pausiert&#39; setzen">
      <bpmn:incoming>SF_U13</bpmn:incoming>
      <bpmn:outgoing>SF_U15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ZahlungsGateway" name="Zahlungs-Gateway informieren (Betrag anpassen/stoppen)">
      <bpmn:incoming>SF_U16</bpmn:incoming>
      <bpmn:outgoing>SF_U17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EmailGenerieren" name="Bestätigungs-E-Mail generieren und versenden">
      <bpmn:incoming>SF_U17</bpmn:incoming>
      <bpmn:outgoing>SF_U18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Zulaessig" name="Ist Änderung zulässig?" gatewayDirection="Diverging">
      <bpmn:incoming>SF_U05</bpmn:incoming>
      <bpmn:outgoing>SF_U06</bpmn:outgoing>
      <bpmn:outgoing>SF_U08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_AenderungsArt" name="Welche Art der Änderung?" gatewayDirection="Diverging">
      <bpmn:incoming>SF_U11</bpmn:incoming>
      <bpmn:outgoing>SF_U12</bpmn:outgoing>
      <bpmn:outgoing>SF_U13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Zusammenfuehrung" name="" gatewayDirection="Converging">
      <bpmn:incoming>SF_U14</bpmn:incoming>
      <bpmn:incoming>SF_U15</bpmn:incoming>
      <bpmn:outgoing>SF_U16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="PG_EndSplit" name="" gatewayDirection="Diverging">
      <bpmn:incoming>SF_U18</bpmn:incoming>
      <bpmn:outgoing>SF_U19</bpmn:outgoing>
      <bpmn:outgoing>SF_U20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EE_BackendAbbruch" name="Abbruch wegen Unzulässigkeit">
      <bpmn:incoming>SF_U07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EE_Backend" name="Backend-Verarbeitung abgeschlossen">
      <bpmn:incoming>SF_U19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_U01" sourceRef="SE_Unternehmen" targetRef="Task_OptionenAnzeigen" />
    <bpmn:sequenceFlow id="SF_U02" sourceRef="Task_OptionenAnzeigen" targetRef="Task_EingabenEntgegennehmen" />
    <bpmn:sequenceFlow id="SF_U03" sourceRef="Task_EingabenEntgegennehmen" targetRef="Task_AnfrageAnBackend" />
    <bpmn:sequenceFlow id="SF_U04" sourceRef="Task_AnfrageAnBackend" targetRef="Task_ZulaessigkeitPruefen" />
    <bpmn:sequenceFlow id="SF_U05" sourceRef="Task_ZulaessigkeitPruefen" targetRef="GW_Zulaessig" />
    <bpmn:sequenceFlow id="SF_U06" name="Nein" sourceRef="GW_Zulaessig" targetRef="Task_FehlermeldungGenerieren" />
    <bpmn:sequenceFlow id="SF_U07" sourceRef="Task_FehlermeldungGenerieren" targetRef="EE_BackendAbbruch" />
    <bpmn:sequenceFlow id="SF_U08" name="Ja" sourceRef="GW_Zulaessig" targetRef="Task_KonditionenBerechnen" />
    <bpmn:sequenceFlow id="SF_U09" sourceRef="Task_KonditionenBerechnen" targetRef="Task_PruefergebnisAnzeigen" />
    <bpmn:sequenceFlow id="SF_U10" sourceRef="Task_PruefergebnisAnzeigen" targetRef="Task_AuftragAnBackend" />
    <bpmn:sequenceFlow id="SF_U11" sourceRef="Task_AuftragAnBackend" targetRef="GW_AenderungsArt" />
    <bpmn:sequenceFlow id="SF_U12" name="Tarifänderung" sourceRef="GW_AenderungsArt" targetRef="Task_TarifAktivieren" />
    <bpmn:sequenceFlow id="SF_U13" name="Pause" sourceRef="GW_AenderungsArt" targetRef="Task_AboPausieren" />
    <bpmn:sequenceFlow id="SF_U14" sourceRef="Task_TarifAktivieren" targetRef="GW_Zusammenfuehrung" />
    <bpmn:sequenceFlow id="SF_U15" sourceRef="Task_AboPausieren" targetRef="GW_Zusammenfuehrung" />
    <bpmn:sequenceFlow id="SF_U16" sourceRef="GW_Zusammenfuehrung" targetRef="Task_ZahlungsGateway" />
    <bpmn:sequenceFlow id="SF_U17" sourceRef="Task_ZahlungsGateway" targetRef="Task_EmailGenerieren" />
    <bpmn:sequenceFlow id="SF_U18" sourceRef="Task_EmailGenerieren" targetRef="PG_EndSplit" />
    <bpmn:sequenceFlow id="SF_U19" sourceRef="PG_EndSplit" targetRef="EE_Backend" />
    <bpmn:sequenceFlow id="SF_U20" sourceRef="PG_EndSplit" targetRef="Task_ErfolgsmeldungAnzeigen" />
    <bpmn:sequenceFlow id="SF_U21" sourceRef="Task_ErfolgsmeldungAnzeigen" targetRef="EE_Unternehmen" />
  </bpmn:process>
