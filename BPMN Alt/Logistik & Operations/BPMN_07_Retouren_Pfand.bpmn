<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Process_07V2" targetNamespace="http://localbite.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_07V2" name="07 – Retouren &amp; Pfand-Management" isExecutable="false">
    <bpmn:documentation>BPMN 07 wickelt Rückgabe, Pfand und Boxzustand ab. Rückgabe erfolgt entweder bei einer nächsten Lieferung über BPMN 06 oder an einem zentralen LocalBite-Rückgabeort. Pfandregel und Zustand/Schaden werden nach erfolgter Rückgabe parallel bearbeitet und anschließend zusammengeführt.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_07V2">
      <bpmn:lane id="L07_SYS" name="System / Pfandverwaltung">
        <bpmn:flowNodeRef>S07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G07_Next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Sched</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Notify06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Result06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G07_Returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Further</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G07_Further</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_CentralInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G07_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E07_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E07_Day30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Retain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E07_Late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G07_MergeReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_History</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G07_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Duration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_DepositRule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_DepositBook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G07_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E07_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L07_OPS" name="Rücknahme / Qualitätsprüfung">
        <bpmn:flowNodeRef>T07_Scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_State</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G07_Damage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_DamageDoc</bpmn:flowNodeRef>
