        <bpmn:flowNodeRef>T07_CustDamage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G07_DmgMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Reuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G07_Treat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07_Recycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G07_TreatMerge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S07" name="Rückgabefall angelegt"/>
    <bpmn:task id="T07_Assign" name="Box-ID Kunde und Bestellung zuordnen"/>
    <bpmn:task id="T07_Monitor" name="Rückgabefrist überwachen"/>
    <bpmn:exclusiveGateway id="G07_Next" name="Nächste Lieferung rechtzeitig?"/>
    <bpmn:task id="T07_Sched" name="Rückgabe bei nächster Lieferung vormerken"/>
    <bpmn:task id="T07_Notify06" name="BPMN 06 über Rücknahme informieren"/>
    <bpmn:task id="T07_Result06" name="Rückgabeergebnis übernehmen"/>
    <bpmn:exclusiveGateway id="G07_Returned" name="Box zurückgegeben?"/>
    <bpmn:task id="T07_Further" name="Weitere rechtzeitige Lieferung prüfen"/>
    <bpmn:exclusiveGateway id="G07_Further" name="Weitere Lieferung möglich?"/>
    <bpmn:task id="T07_CentralInfo" name="Zentralen LocalBite-Rückgabeort mitteilen"/>
    <bpmn:eventBasedGateway id="G07_Wait" name="Auf Rückgabe oder Tag 30 warten"/>
    <bpmn:intermediateCatchEvent id="E07_Return" name="Box zentral zurückgegeben">
      <bpmn:messageEventDefinition messageRef="Msg_07_Return"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E07_Day30" name="Tag 30 erreicht">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P16D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T07_Retain" name="Pfand vollständig einbehalten"/>
    <bpmn:intermediateCatchEvent id="E07_Late" name="Späte Rückgabe erhalten">
      <bpmn:messageEventDefinition messageRef="Msg_07_Return"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G07_MergeReturn" name="Rückgabe erfolgt"/>
    <bpmn:manualTask id="T07_Scan" name="Box-ID scannen / Rückgabe registrieren"/>
    <bpmn:task id="T07_History" name="Box-Historie und Vorschäden laden"/>
    <bpmn:userTask id="T07_State" name="Boxzustand dokumentieren"/>
    <bpmn:parallelGateway id="G07_Split" name="Pfand und Zustand parallel bearbeiten"/>
    <bpmn:task id="T07_Duration" name="Rückgabedauer berechnen"/>
    <bpmn:task id="T07_DepositRule" name="Pfandanspruch nach Fristregel bestimmen"/>
    <bpmn:task id="T07_DepositBook" name="Pfand erstatten / einbehalten und verbuchen"/>
    <bpmn:task id="T07_Compare" name="Zustand mit Box-Historie vergleichen"/>
    <bpmn:exclusiveGateway id="G07_Damage" name="Neuer erheblicher Schaden?"/>
    <bpmn:userTask id="T07_DamageDoc" name="Schaden dokumentieren"/>
    <bpmn:exclusiveGateway id="G07_Cause" name="Verursachung eindeutig?"/>
    <bpmn:userTask id="T07_CustDamage" name="Möglichen Kundenschadensfall prüfen"/>
    <bpmn:userTask id="T07_Manual" name="Manuelle Schadensklärung"/>
    <bpmn:exclusiveGateway id="G07_DmgMerge" name="Schaden geklärt"/>
    <bpmn:userTask id="T07_Reuse" name="Wiederverwendbarkeit bestimmen"/>
    <bpmn:exclusiveGateway id="G07_Treat" name="Behandlung der Box"/>
    <bpmn:manualTask id="T07_Clean" name="Box reinigen"/>
    <bpmn:manualTask id="T07_Repair" name="Box reparieren und anschließend reinigen"/>
    <bpmn:manualTask id="T07_Recycle" name="Box aussortieren / Recycling"/>
    <bpmn:exclusiveGateway id="G07_TreatMerge" name="Boxbehandlung abgeschlossen"/>
    <bpmn:parallelGateway id="G07_Join" name="Pfand und Boxbehandlung abgeschlossen"/>
    <bpmn:task id="T07_Stock" name="Boxbestand / Boxstatus aktualisieren"/>
    <bpmn:endEvent id="E07_End" name="Rückgabefall abgeschlossen"/>
    <bpmn:dataStoreReference id="DS07_History" name="Box-Historie" dataStoreRef="DS07_History_def"/>
