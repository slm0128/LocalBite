    <bpmn:textAnnotation id="ANN07_RULE">
      <bpmn:text>Pfandregel: Tag 0–14 = 100 %, Tag 15–21 = 75 %, Tag 22–29 = 50 %, ab Tag 30 = 0 %. Pfand und Schadensersatz werden getrennt behandelt.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A07_Rule" sourceRef="ANN07_RULE" targetRef="T07_DepositRule"/>
    <bpmn:textAnnotation id="ANN07_TODO">
      <bpmn:text>TODO: zentralen Rückgabeort, absolute Pfandhöhe, Boxgrößen sowie konkrete Scan-/RFID-/Kameratechnik final festlegen. Material: langlebige lebensmittelechte Mehrwegbox aus Recycling-Kunststoff.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A07_Todo" sourceRef="ANN07_TODO" targetRef="T07_State"/>
