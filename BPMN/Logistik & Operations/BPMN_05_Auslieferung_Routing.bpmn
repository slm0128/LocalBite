<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Process_05V2" targetNamespace="http://localbite.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_05V2" name="05 – Auslieferung &amp; Routing" isExecutable="false">
    <bpmn:documentation>BPMN 05 plant und optimiert Touren für ein Lieferdatum D. Der vorgelagerte Bedarfs-/Bestandsabgleich liefert verbindlich geklärte Mengen. BPMN 05 bildet Kundengruppen, bestimmt Abholpunkte, berechnet Abhol- und Lieferreihenfolgen, prüft Restriktionen und gibt fertige Touren an BPMN 06 weiter. Konkrete Fahrzeug-ID und Fahrerzuweisung gehören nicht in BPMN 05.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_05V2">
      <bpmn:lane id="L05_SYS" name="System / Routing">
        <bpmn:flowNodeRef>S05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Forecast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Grob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E05_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Points</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Group</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G05_Doable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_TourReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_PickPts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_PickRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_DelRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G05_Good</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E05_T0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G05_Change</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L05_DISP" name="Disposition / Logistikplanung">
        <bpmn:flowNodeRef>T05_Regroup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Optimize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Replan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05_Release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E05_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S05" name="T-2 Planungszeitpunkt erreicht"/>
    <bpmn:task id="T05_Forecast" name="Forecast und bekannte Bestellungen auswerten"/>
    <bpmn:task id="T05_Grob" name="Liefergebiete und groben Transportbedarf prognostizieren"/>
    <bpmn:intermediateCatchEvent id="E05_T1" name="T-1 erreicht">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T05_Input" name="Verbindliche Bedarfs- und Warenfreigabe übernehmen"/>
    <bpmn:task id="T05_Points" name="Abholorte und Lieferziele festlegen"/>
    <bpmn:task id="T05_Req" name="Transportanforderungen je Bestellung bestimmen"/>
    <bpmn:task id="T05_Group" name="Kunden vorläufig zu Touren bündeln"/>
    <bpmn:exclusiveGateway id="G05_Doable" name="Tourgruppe grundsätzlich machbar?"/>
    <bpmn:userTask id="T05_Regroup" name="Kundengruppe teilen / neu zusammenstellen"/>
    <bpmn:task id="T05_TourReq" name="Touranforderungen bestimmen"/>
    <bpmn:task id="T05_PickPts" name="Benötigte Abholorte je Tour bestimmen"/>
    <bpmn:task id="T05_PickRoute" name="Abholreihenfolge berechnen"/>
    <bpmn:task id="T05_DelRoute" name="Lieferreihenfolge berechnen"/>
    <bpmn:task id="T05_Check" name="Gesamttour gegen Kapazität, Ausstattung, Zeitfenster und Dauer prüfen"/>
    <bpmn:exclusiveGateway id="G05_Good" name="Tour sinnvoll?"/>
    <bpmn:userTask id="T05_Optimize" name="Tour optimieren / Kundengruppe anpassen"/>
    <bpmn:task id="T05_Save" name="Tour vorläufig speichern"/>
    <bpmn:intermediateCatchEvent id="E05_T0" name="T-0 erreicht">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T05_Final" name="Finalen Änderungscheck durchführen"/>
    <bpmn:exclusiveGateway id="G05_Change" name="Anpassung nötig?"/>
    <bpmn:userTask id="T05_Replan" name="Betroffene Tour gezielt nachplanen"/>
    <bpmn:userTask id="T05_Release" name="Tour verbindlich freigeben"/>
    <bpmn:endEvent id="E05_End" name="Tour geplant und freigegeben"/>
    <bpmn:dataStoreReference id="DS05_Geo" name="Geodaten / Adressen" dataStoreRef="DS05_Geo_def"/>
    <bpmn:dataObject id="DO05_Tour_obj" name="Tourplan"/>
    <bpmn:dataObjectReference id="DO05_Tour" name="Tourplan" dataObjectRef="DO05_Tour_obj"/>
    <bpmn:sequenceFlow id="F05_01" sourceRef="S05" targetRef="T05_Forecast"/>
    <bpmn:sequenceFlow id="F05_02" sourceRef="T05_Forecast" targetRef="T05_Grob"/>
    <bpmn:sequenceFlow id="F05_03" sourceRef="T05_Grob" targetRef="E05_T1"/>
    <bpmn:sequenceFlow id="F05_04" sourceRef="E05_T1" targetRef="T05_Input"/>
    <bpmn:sequenceFlow id="F05_05" sourceRef="T05_Input" targetRef="T05_Points"/>
    <bpmn:sequenceFlow id="F05_06" sourceRef="T05_Points" targetRef="T05_Req"/>
    <bpmn:sequenceFlow id="F05_07" sourceRef="T05_Req" targetRef="T05_Group"/>
    <bpmn:sequenceFlow id="F05_08" sourceRef="T05_Group" targetRef="G05_Doable"/>
    <bpmn:sequenceFlow id="F05_09" sourceRef="G05_Doable" targetRef="T05_TourReq" name="Ja"/>
    <bpmn:sequenceFlow id="F05_10" sourceRef="T05_TourReq" targetRef="T05_PickPts"/>
    <bpmn:sequenceFlow id="F05_11" sourceRef="T05_PickPts" targetRef="T05_PickRoute"/>
    <bpmn:sequenceFlow id="F05_12" sourceRef="T05_PickRoute" targetRef="T05_DelRoute"/>
    <bpmn:sequenceFlow id="F05_13" sourceRef="T05_DelRoute" targetRef="T05_Check"/>
    <bpmn:sequenceFlow id="F05_14" sourceRef="T05_Check" targetRef="G05_Good"/>
    <bpmn:sequenceFlow id="F05_15" sourceRef="G05_Good" targetRef="T05_Save" name="Ja"/>
    <bpmn:sequenceFlow id="F05_16" sourceRef="T05_Save" targetRef="E05_T0"/>
    <bpmn:sequenceFlow id="F05_17" sourceRef="E05_T0" targetRef="T05_Final"/>
    <bpmn:sequenceFlow id="F05_18" sourceRef="T05_Final" targetRef="G05_Change"/>
    <bpmn:sequenceFlow id="F05_19" sourceRef="G05_Change" targetRef="T05_Release" name="Nein"/>
    <bpmn:sequenceFlow id="F05_20" sourceRef="T05_Release" targetRef="E05_End"/>
    <bpmn:sequenceFlow id="F05_RegroupOut" sourceRef="G05_Doable" targetRef="T05_Regroup" name="Nein"/>
    <bpmn:sequenceFlow id="F05_RegroupBack" sourceRef="T05_Regroup" targetRef="T05_Group" name="Neu bündeln"/>
    <bpmn:sequenceFlow id="F05_OptimizeOut" sourceRef="G05_Good" targetRef="T05_Optimize" name="Nein"/>
    <bpmn:sequenceFlow id="F05_OptimizeBack" sourceRef="T05_Optimize" targetRef="T05_Group" name="Neu optimieren"/>
    <bpmn:sequenceFlow id="F05_ReplanOut" sourceRef="G05_Change" targetRef="T05_Replan" name="Ja"/>
    <bpmn:sequenceFlow id="F05_ReplanBack" sourceRef="T05_Replan" targetRef="T05_Check" name="Gezielt nachplanen"/>
    <bpmn:association id="A05_Geo" sourceRef="DS05_Geo" targetRef="T05_PickRoute"/>
    <bpmn:association id="A05_Tour" sourceRef="T05_Release" targetRef="DO05_Tour"/>
    <bpmn:textAnnotation id="ANN05">
      <bpmn:text>Offen: Hub vs. direkte Abholung, konkrete Cutoff-Zeiten und finale Fahrzeugklassen. Diese Details ändern die Grundstruktur nicht.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A05_Ann" sourceRef="ANN05" targetRef="T05_Final"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Process_05V2">
    <bpmn:participant id="Participant_Process_05V2" name="05 – Auslieferung &amp; Routing" processRef="Process_05V2"/>
