    <bpmn:startEvent id="S06" name="Freigegebene Tour erhalten">
      <bpmn:messageEventDefinition messageRef="Msg_06_Tour"/>
    </bpmn:startEvent>
    <bpmn:task id="T06_Req" name="Touranforderungen prüfen"/>
    <bpmn:task id="T06_Vehicle" name="Konkretes geeignetes Fahrzeug auswählen"/>
    <bpmn:exclusiveGateway id="G06_Veh" name="Fahrzeug verfügbar?"/>
    <bpmn:userTask id="T06_VehReplace" name="Ersatzfahrzeug suchen"/>
    <bpmn:exclusiveGateway id="G06_VehRep" name="Ersatz gefunden?"/>
