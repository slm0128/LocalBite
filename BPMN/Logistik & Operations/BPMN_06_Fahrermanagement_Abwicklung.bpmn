<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Process_06V2" targetNamespace="http://localbite.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_06V2" name="06 – Fahrermanagement &amp; Abwicklung" isExecutable="false">
    <bpmn:documentation>BPMN 06 übernimmt eine in BPMN 05 geplante und freigegebene Tour. Es wählt konkrete Ressourcen, organisiert Warenübernahme/Beladung, führt die Stopp-Schleife aus und behandelt operative Störungen. Nur wenn eine Tour nicht mehr lokal ausführbar ist, wird an BPMN 05 zur Neuplanung eskaliert.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_06V2">
      <bpmn:lane id="L06_DISP" name="Disposition / System">
        <bpmn:flowNodeRef>S06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_Req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_Vehicle</bpmn:flowNodeRef>
