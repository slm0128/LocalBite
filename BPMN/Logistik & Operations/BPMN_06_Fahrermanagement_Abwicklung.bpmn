    <bpmn:textAnnotation id="ANN06">
      <bpmn:text>Fahrzeug-zu-Fahrzeug-Transfer ist nur ein Ausnahme-Fallback, z. B. bei Ausfall, Überlastung oder starker Verspätung. Hub vs. direkte Abholung bleibt offen.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A06_Ann" sourceRef="ANN06" targetRef="T06_Fallback"/>
