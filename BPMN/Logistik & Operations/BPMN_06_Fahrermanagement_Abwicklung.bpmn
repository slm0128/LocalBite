    <bpmn:userTask id="T06_DrvReplace" name="Ersatzfahrer suchen"/>
    <bpmn:exclusiveGateway id="G06_DrvRep" name="Ersatz gefunden?"/>
    <bpmn:task id="T06_Assign" name="Fahrzeug und Fahrer verbindlich zuweisen"/>
    <bpmn:task id="T06_Replan" name="Neuplanung / Verschiebung an BPMN 05 melden"/>
    <bpmn:endEvent id="E06_ReplanEnd" name="Neuplanung angefordert"/>
    <bpmn:task id="T06_Order" name="Tourauftrag und Übergabeinformationen bereitstellen"/>
    <bpmn:manualTask id="T06_Prepare" name="Warenübernahme vorbereiten"/>
    <bpmn:userTask id="T06_CheckGoods" name="Ware bei Übernahme auf Menge, Zustand, Verpackung und Temperatur prüfen"/>
    <bpmn:exclusiveGateway id="G06_Goods" name="Ware transportfähig?"/>
    <bpmn:userTask id="T06_LocalFix" name="Problem lokal klären"/>
    <bpmn:exclusiveGateway id="G06_Local" name="Lokal lösbar?"/>
    <bpmn:task id="T06_GoodsReplan" name="Teil-Neuplanung an Disposition / BPMN 05 melden"/>
    <bpmn:manualTask id="T06_Load" name="Fahrzeug beladen"/>
    <bpmn:userTask id="T06_Secure" name="Beladung, Temperatur und Sicherung kontrollieren"/>
    <bpmn:userTask id="T06_Handover" name="Fahrzeug und Tour an Fahrer übergeben"/>
    <bpmn:userTask id="T06_Take" name="Fahrer übernimmt Fahrzeug und Tour"/>
    <bpmn:userTask id="T06_Start" name="Tour starten / Status unterwegs setzen"/>
    <bpmn:userTask id="T06_Next" name="Nächsten geplanten Stopp anfahren"/>
    <bpmn:exclusiveGateway id="G06_Stop" name="Stoppart?"/>
    <bpmn:manualTask id="T06_Pick" name="Ware am Abholort übernehmen"/>
    <bpmn:userTask id="T06_PickConf" name="Menge und Zustand bestätigen"/>
    <bpmn:manualTask id="T06_Deliver" name="Bestellung zustellen / vorgemerkte Pfandbox mitnehmen"/>
    <bpmn:userTask id="T06_DelConf" name="Zustellung / Rückgabe bestätigen"/>
    <bpmn:exclusiveGateway id="G06_StopMerge" name="Stopp abgeschlossen"/>
    <bpmn:task id="T06_Status" name="Tour- und Lieferstatus aktualisieren"/>
    <bpmn:exclusiveGateway id="G06_Prob" name="Problem aufgetreten?"/>
    <bpmn:userTask id="T06_ProbEval" name="Problem bewerten und lokalen Fallback prüfen"/>
    <bpmn:exclusiveGateway id="G06_Mach" name="Tour weiterhin machbar?"/>
    <bpmn:userTask id="T06_Fallback" name="Operativen Fallback koordinieren (z. B. Ersatz oder Fahrzeug-zu-Fahrzeug-Transfer)"/>
    <bpmn:exclusiveGateway id="G06_Continue" name="Fortsetzung möglich?"/>
    <bpmn:task id="T06_Abort" name="Tourabbruch / Neuplanung an BPMN 05 melden"/>
    <bpmn:exclusiveGateway id="G06_More" name="Weitere Stopps?"/>
    <bpmn:userTask id="T06_Return" name="Rückfahrt / Übergabe am LocalBite-Standort"/>
    <bpmn:manualTask id="T06_Returns" name="Restware, Pfandboxen und Retouren übergeben"/>
    <bpmn:task id="T06_VehStatus" name="Fahrzeugstatus melden"/>
    <bpmn:task id="T06_Doc" name="Tourergebnis dokumentieren"/>
    <bpmn:endEvent id="E06_End" name="Tour abgeschlossen"/>
