        <bpmn:flowNodeRef>T06_Fallback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G06_Continue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_Abort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_VehStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_Doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E06_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L06_OPS" name="Operations / Warenübergabe">
        <bpmn:flowNodeRef>T06_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06_CheckGoods</bpmn:flowNodeRef>
